{
  "manifest_version": 2,
  "name": "Цвет сайта",
  "description": "Передаёт браузеру цвет сайта, чтобы нижняя панель подстраивалась под его тему.",
  "version": "1.0",
  "browser_specific_settings": { "gecko": { "id": "site-color@hrips.app" } },
  "permissions": ["nativeMessaging", "nativeMessagingFromContent", "geckoViewAddons"],
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}
