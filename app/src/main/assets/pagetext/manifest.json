{
  "manifest_version": 2,
  "name": "Текст страниц для поиска по вкладкам",
  "description": "Отдаёт приложению видимый текст страницы, чтобы поиск на экране вкладок искал по содержимому страниц. Текст хранится только в памяти.",
  "version": "1.0",
  "browser_specific_settings": {
    "gecko": {
      "id": "pagetext@hrips.app"
    }
  },
  "permissions": [
    "nativeMessaging",
    "nativeMessagingFromContent",
    "geckoViewAddons"
  ],
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}
